# =====================================================
# EXAMPLE CONFIGURATION
# Copy this file as .env and adjust the values
# =====================================================

# Port
PORT=8000

# DataBase
DATABASE_URL="mysql://hicrew_user:hicrew_password@localhost:3306/hicrew"

# JWT Secret (IMPORTANT: change)
JWT_SECRET=local-development-secret-key-change-this-12345

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_NAME=HiCrew

# URLs frontend
FRONTEND_URL=http://localhost:3000

# =====================================================
# AIRLINE CONFIGURATION
# =====================================================
ICAO_AIRLINE="HCW"

# IVAO API Configuration (OPTIONAL)
IVAO_API_KEY=tu_api_key_aqui
IVAO_CLIENT_ID=tu_client_id_aqui
IVAO_CLIENT_SECRET=tu_client_secret_aqui