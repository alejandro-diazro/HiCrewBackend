generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Pilot {
  id                   Int               @id @default(autoincrement())
  email                String            @unique
  ivaoId               String?           @unique
  vatsimId             String?           @unique
  firstName            String
  lastName             String
  birthDate            DateTime?
  callsign             String?
  password             String?
  hours                Float             @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  locationIcao         String?
  points               Int               @default(0)
  rankId               Int?
  onVacation           Boolean           @default(false)
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  simbriefAccount      String?
  flights              Flight[]
  location             Airport?          @relation(fields: [locationIcao], references: [icao])
  rank                 Rank?             @relation(fields: [rankId], references: [id])
  pilotAirline         PilotAirline?     @relation("PilotToPilotAirline")
  pilotHub             PilotHub?         @relation("PilotToPilotHub")
  pilotMedals          PilotMedal[]
  pilotPermissions     PilotPermission[]
  reportTours          ReportTour[]
  tourEnrollments      TourEnrollment[]
  staffList            StaffList?        @relation("PilotToStaffList")
  battlePassProgress   PilotBattlePassProgress[]

  @@index([locationIcao], map: "Pilot_locationIcao_fkey")
  @@index([rankId], map: "Pilot_rankId_fkey")
}

model Permission {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  pilotPermissions PilotPermission[]
}

model PilotPermission {
  pilotId      Int        @map("pilot_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  pilot        Pilot      @relation(fields: [pilotId], references: [id])

  @@id([pilotId, permissionId])
  @@index([permissionId], map: "PilotPermissions_permission_id_fkey")
  @@map("PilotPermissions")
}

model Flight {
  id            Int       @id @default(autoincrement())
  pilotId       Int
  aircraft      String
  status        Int
  pirep         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  arrivalIcao   String
  closeFlight   DateTime?
  departureIcao String
  fleetId       Int?
  routeId       Int?
  startFlight   DateTime?
  type          Int
  comment       String?
  callsign      String
  network       String?
  simbriefData  String?   @db.LongText
  extraData     String?   @db.LongText
  tourEnrollmentId Int?
  legId         Int?
  arrival       Airport   @relation("ArrivalFlight", fields: [arrivalIcao], references: [icao])
  departure     Airport   @relation("DepartureFlight", fields: [departureIcao], references: [icao])
  fleet         Fleet?    @relation(fields: [fleetId], references: [id])
  pilot         Pilot     @relation(fields: [pilotId], references: [id])
  route         Route?    @relation(fields: [routeId], references: [id])
  tourEnrollment TourEnrollment? @relation(fields: [tourEnrollmentId], references: [id])
  leg           Leg?      @relation(fields: [legId], references: [id])

  @@index([arrivalIcao], map: "Flight_arrivalIcao_fkey")
  @@index([departureIcao], map: "Flight_departureIcao_fkey")
  @@index([fleetId], map: "Flight_fleetId_fkey")
  @@index([pilotId], map: "Flight_pilotId_fkey")
  @@index([routeId], map: "Flight_routeId_fkey")
  @@index([tourEnrollmentId], map: "Flight_tourEnrollmentId_fkey")
  @@index([legId], map: "Flight_legId_fkey")
}

model Rules {
  id        Int      @id @default(autoincrement())
  lang      String   @db.VarChar(4)
  title     String?  @db.VarChar(255)
  text      String   @db.VarChar(1024)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lang, title])
}

model SocialNetwork {
  id        Int      @id @default(autoincrement())
  icon      String   @db.VarChar(255)
  url       String   @db.VarChar(255)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Documentation {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(255)
  name      String   @db.VarChar(100)
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id               Int      @id @default(autoincrement())
  time_event_start DateTime
  time_event_end   DateTime
  open_view_date   DateTime
  close_view_date  DateTime
  text             String   @db.VarChar(1024)
  description      String   @db.VarChar(2048)
  banner           String   @db.VarChar(255)
  points           Int
  lang             String   @db.VarChar(4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notam {
  id               Int      @id @default(autoincrement())
  title            String   @db.VarChar(255)
  text             String   @db.VarChar(1024)
  lang             String   @db.VarChar(4)
  active_date      DateTime
  desactivate_date DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Config {
  name        String   @id
  description String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Simulator {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  logo      String     @db.VarChar(255)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  paintkits Paintkit[]
}

model Airline {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(100)
  logo          String         @db.VarChar(255)
  tail          String         @db.VarChar(255)
  can_join      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  fleet         Fleet[]
  hubs          Hub[]
  pilotAirlines PilotAirline[]
  routes        Route[]
}

model Medal {
  id          Int          @id @default(autoincrement())
  img         String       @db.VarChar(255)
  text        String       @db.VarChar(255)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  pilotMedals PilotMedal[]
  tours       Tour[]
}

model Rank {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  img       String   @db.VarChar(255)
  hours     Int
  level     Int      @default(0)
  flights   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fleets    Fleet[]
  hubs      Hub[]
  pilots    Pilot[]
}

model Airport {
  icao             String   @id @db.VarChar(4)
  iata             String?  @db.VarChar(3)
  name             String   @db.VarChar(100)
  country          String   @db.VarChar(100)
  latitude         Float
  longitude        Float
  altitude         Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  fleets           Fleet[]  @relation("FleetLocation")
  arrivalFlights   Flight[] @relation("ArrivalFlight")
  departureFlights Flight[] @relation("DepartureFlight")
  hubs             Hub[]
  arrivalLegs      Leg[]    @relation("ArrivalLeg")
  departureLegs    Leg[]    @relation("DepartureLeg")
  pilots           Pilot[]
  arrivalRoutes    Route[]  @relation("ArrivalAirport")
  departureRoutes  Route[]  @relation("DepartureAirport")
}

model Aircraft {
  id             Int        @id @default(autoincrement())
  icao           String     @db.VarChar(4)
  manufacturer   String     @db.VarChar(100)
  model          String     @db.VarChar(100)
  range          Int
  max_passengers Int
  img            String     @db.VarChar(255)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  fleet          Fleet[]
  paintkits      Paintkit[]
  routes         Route[]    @relation("RouteAircraft")
}

model Fleet {
  id           Int      @id @default(autoincrement())
  aircraftId   Int
  airlineId    Int
  name         String   @db.VarChar(100)
  reg          String   @db.VarChar(6)
  state        Int
  life         Int
  rankId       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hubId        Int?
  locationIcao String   @db.VarChar(4)
  aircraft     Aircraft @relation(fields: [aircraftId], references: [id])
  airline      Airline  @relation(fields: [airlineId], references: [id])
  hub          Hub?     @relation(fields: [hubId], references: [id])
  location     Airport  @relation("FleetLocation", fields: [locationIcao], references: [icao])
  rank         Rank?    @relation(fields: [rankId], references: [id])
  flights      Flight[]

  @@index([aircraftId], map: "Fleet_aircraftId_fkey")
  @@index([airlineId], map: "Fleet_airlineId_fkey")
  @@index([hubId], map: "Fleet_hubId_fkey")
  @@index([locationIcao], map: "Fleet_locationIcao_fkey")
  @@index([rankId], map: "Fleet_rankId_fkey")
}

model Paintkit {
  id          Int       @id @default(autoincrement())
  simulatorId Int
  url         String    @db.VarChar(255)
  aircraftId  Int
  developer   String    @db.VarChar(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  aircraft    Aircraft  @relation(fields: [aircraftId], references: [id])
  simulator   Simulator @relation(fields: [simulatorId], references: [id])

  @@index([aircraftId], map: "Paintkit_aircraftId_fkey")
  @@index([simulatorId], map: "Paintkit_simulatorId_fkey")
}

model Route {
  id            Int      @id @default(autoincrement())
  departureIcao String
  arrivalIcao   String
  airlineId     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  aircraftId    Int
  callsign      String   @db.VarChar(8)
  flights       Flight[]
  aircraft      Aircraft @relation("RouteAircraft", fields: [aircraftId], references: [id])
  airline       Airline  @relation(fields: [airlineId], references: [id])
  arrival       Airport  @relation("ArrivalAirport", fields: [arrivalIcao], references: [icao])
  departure     Airport  @relation("DepartureAirport", fields: [departureIcao], references: [icao])

  @@index([aircraftId], map: "Route_aircraftId_fkey")
  @@index([airlineId], map: "Route_airlineId_fkey")
  @@index([arrivalIcao], map: "Route_arrivalIcao_fkey")
  @@index([departureIcao], map: "Route_departureIcao_fkey")
}

model RequestJoin {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  id_ivao   String?  @db.VarChar(20)
  id_vatsim String?  @db.VarChar(20)
  birthday  DateTime
  email     String   @db.VarChar(255)
  status    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tour {
  id                   Int      @id @default(autoincrement())
  medalId              Int?
  img                  String   @db.VarChar(500)
  name                 String   @db.VarChar(100)
  description          String   @db.Text
  shortDescription     String   @db.VarChar(255)
  open_day             DateTime
  close_day            DateTime
  isActive             Boolean  @default(true)
  recommendedAircrafts String?  @db.Text
  bannerImage          String?  @db.VarChar(500)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  legs                 Leg[]
  medal                Medal?   @relation(fields: [medalId], references: [id])
  enrollments          TourEnrollment[]

  @@index([medalId], map: "Tour_medalId_fkey")
}

model TourEnrollment {
  id               Int      @id @default(autoincrement())
  pilotId          Int
  pilot            Pilot    @relation(fields: [pilotId], references: [id])
  tourId           Int
  tour             Tour     @relation(fields: [tourId], references: [id])
  currentLegOrder  Int      @default(1)
  completedLegs    Int      @default(0)
  isCompleted      Boolean  @default(false)
  enrolledAt       DateTime @default(now())
  completedAt      DateTime?
  flights          Flight[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@unique([pilotId, tourId])
  @@index([pilotId], map: "TourEnrollment_pilotId_fkey")
  @@index([tourId], map: "TourEnrollment_tourId_fkey")
}

model Leg {
  id                   Int          @id @default(autoincrement())
  tourId               Int
  airportDepartureIcao String
  airportArrivalIcao   String
  order                Int          @default(1)
  distance             Float?       @default(0)
  estimatedTime        Int?         @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  airportArrival       Airport      @relation("ArrivalLeg", fields: [airportArrivalIcao], references: [icao])
  airportDeparture     Airport      @relation("DepartureLeg", fields: [airportDepartureIcao], references: [icao])
  tour                 Tour         @relation(fields: [tourId], references: [id])
  reportTours          ReportTour[]
  flights              Flight[]

  @@index([airportArrivalIcao], map: "Leg_airportArrivalIcao_fkey")
  @@index([airportDepartureIcao], map: "Leg_airportDepartureIcao_fkey")
  @@index([tourId], map: "Leg_tourId_fkey")
}

model ReportTour {
  id             Int      @id @default(autoincrement())
  userId         Int
  legId          Int
  status         Int      @default(0)
  time_departure DateTime
  time_arrival   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leg            Leg      @relation(fields: [legId], references: [id])
  user           Pilot    @relation(fields: [userId], references: [id])

  @@index([legId], map: "ReportTour_legId_fkey")
  @@index([userId], map: "ReportTour_userId_fkey")
}

model StaffList {
  id               Int      @id @default(autoincrement())
  pilotId          Int      @unique
  nameRolePosition String   @db.VarChar(100)
  priority         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  pilot            Pilot    @relation("PilotToStaffList", fields: [pilotId], references: [id], onDelete: Cascade)
}

model Hub {
  id        Int        @id @default(autoincrement())
  airportId String     @map("airport_id")
  airlineId Int        @map("airline_id")
  rankId    Int?       @map("rank_id")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  fleets    Fleet[]
  airline   Airline    @relation(fields: [airlineId], references: [id])
  airport   Airport    @relation(fields: [airportId], references: [icao])
  rank      Rank?      @relation(fields: [rankId], references: [id])
  pilotHubs PilotHub[]

  @@index([airlineId], map: "Hub_airline_id_fkey")
  @@index([airportId], map: "Hub_airport_id_fkey")
  @@index([rankId], map: "Hub_rank_id_fkey")
}

model PilotAirline {
  id        Int      @id @default(autoincrement())
  pilotId   Int      @unique
  airlineId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  airline   Airline  @relation(fields: [airlineId], references: [id])
  pilot     Pilot    @relation("PilotToPilotAirline", fields: [pilotId], references: [id])

  @@index([airlineId], map: "PilotAirline_airlineId_fkey")
}

model PilotHub {
  id        Int      @id @default(autoincrement())
  pilotId   Int      @unique
  hubId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hub       Hub      @relation(fields: [hubId], references: [id])
  pilot     Pilot    @relation("PilotToPilotHub", fields: [pilotId], references: [id])

  @@index([hubId], map: "PilotHub_hubId_fkey")
}

model PilotMedal {
  pilotId   Int      @map("pilot_id")
  medalId   Int      @map("medal_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  medal     Medal    @relation(fields: [medalId], references: [id], onDelete: Cascade)
  pilot     Pilot    @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@id([pilotId, medalId])
  @@index([medalId], map: "PilotMedals_medal_id_fkey")
  @@map("PilotMedals")
}

model BattlePass {
  id          Int                      @id @default(autoincrement())
  name        String                   @db.VarChar(100)
  description String?                  @db.Text
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  challenges  BattlePassChallenge[]
  progress    PilotBattlePassProgress[]
}

model BattlePassChallenge {
  id           Int      @id @default(autoincrement())
  battlePassId Int
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  targetValue  Int
  points       Int
  icon         String?  @db.VarChar(255)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  battlePass   BattlePass @relation(fields: [battlePassId], references: [id], onDelete: Cascade)

  @@index([battlePassId], map: "BattlePassChallenge_battlePassId_fkey")
}

model PilotBattlePassProgress {
  id           Int        @id @default(autoincrement())
  pilotId      Int
  battlePassId Int
  currentValue Int        @default(0)
  isCompleted  Boolean    @default(false)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  pilot        Pilot      @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  battlePass   BattlePass @relation(fields: [battlePassId], references: [id], onDelete: Cascade)

  @@unique([pilotId, battlePassId])
  @@index([pilotId], map: "PilotBattlePassProgress_pilotId_fkey")
  @@index([battlePassId], map: "PilotBattlePassProgress_battlePassId_fkey")
}
